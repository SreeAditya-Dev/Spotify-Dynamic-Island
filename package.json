{
  "name": "spotify-dynamic-island",
  "productName": "Nilo",
  "desktopName": "nilo",
  "version": "1.0.0",
  "description": "Ultra-smooth, low-memory Dynamic Island for Spotify on Windows, Mac, and Linux",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "settings": "electron . --settings",
    "build": "tsc && vite build && node scripts/copy-daemon.js",
    "start": "electron .",
    "package": "node scripts/package-app.js",
    "dist": "npm run build && electron-builder",
    "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "test": "tsx tests/run_all_tests.ts"
  },
  "keywords": [
    "spotify",
    "dynamic-island",
    "electron",
    "smtc",
    "mpris",
    "desktop-widget"
  ],
  "author": "V Sree Aditya <leoharrychan.01@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.3"
  }
}
